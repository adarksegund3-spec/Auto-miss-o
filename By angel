local function rewriteArgs(args, p)
  local cam = workspace.CurrentCamera
  local org = cam and cam.CFrame.Position or Vector3.new()
  local _, myRoot = getChar()
  local me = myRoot and myRoot.Position or org
  local model = S.target and S.target.model
  local hum = model and model:FindFirstChildOfClass("Humanoid")
  local changed = false
  local function near(pos) return (pos - me).Magnitude < 12 or (pos - org).Magnitude < 12 end
  local function rw(v, depth)
    local t = typeof(v)
    if t == "Instance" then
      if isMine(v) then return v end
      if v:IsA("Humanoid") then
        if hum and v ~= hum then changed = true return hum end
        return v
      end
      if v:IsA("BasePart") then
        if model and v:IsDescendantOf(model) then return v end
        changed = true return p
      end
      if v:IsA("Model") and model and v ~= model and v:FindFirstChildOfClass("Humanoid") then
        changed = true return model
      end
      return v
    elseif t == "Vector3" then
      local mg = v.Magnitude
      if mg < 0.5 then return v end
      if mg <= 1.5 then changed = true return (p.Position - org).Unit end
      if near(v) then return v end
      changed = true return p.Position
    elseif t == "CFrame" then
      if near(v.Position) then return v end
      changed = true return CFrame.new(p.Position)
    elseif t == "table" and depth < 2 then
      local c = {}
      for k, x in pairs(v) do c[k] = rw(x, depth + 1) end
      return c
    end
    return v
  end
  local out = {}
  for i = 1, args.n do out[i] = rw(args[i], 0) end
  return changed, out
end

if hookmetamethod and getnamecallmethod and checkcaller then
  local old
  local function pass(self, m, ...)
    if setnamecallmethod then setnamecallmethod(m) end
    return old(self, ...)
  end
  local hook = function(self, ...)
    if checkcaller() then return old(self, ...) end
    local m = getnamecallmethod()
    if SA.dead then return pass(self, m, ...) end
    if self == workspace then
      local p = saTarget()
      if p then
        if m == "Raycast" then
          local o, d, prm = ...
          if typeof(o) == "Vector3" and typeof(d) == "Vector3" and d.Magnitude >= 50 then
            local nd = p.Position - o
            return pass(self, m, o, nd.Unit * math.max(d.Magnitude, nd.Magnitude + 5), prm)
          end
        elseif m == "FindPartOnRay" or m == "FindPartOnRayWithIgnoreList" or m == "FindPartOnRayWithWhitelist" then
          local ray, a1, b1, c1 = ...
          if typeof(ray) == "Ray" and ray.Direction.Magnitude >= 50 then
            local nd = p.Position - ray.Origin
            return pass(self, m, Ray.new(ray.Origin, nd.Unit * math.max(ray.Direction.Magnitude, nd.Magnitude + 5)), a1, b1, c1)
          end
        end
      end
    elseif m == "FireServer" or m == "InvokeServer" then
      local p = saTarget()
      if p and CFG.rewrite and S.target and remoteMatch(self) then
        local args = table.pack(...)
        local ok, changed, out = pcall(rewriteArgs, args, p)
        if ok and changed then return pass(self, m, table.unpack(out, 1, args.n)) end
      end
    end
    return pass(self, m, ...)
  end
  old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(hook) or hook)

  local mouse = LP:GetMouse()
  local oldIdx
  oldIdx = hookmetamethod(game, "__index", function(self, k)
    if (k == "Hit" or k == "Target") and self == mouse and not checkcaller() then
      local p = saTarget()
      if p then return k == "Hit" and CFrame.new(p.Position) or p end
    end
    return oldIdx(self, k)
  end)
end

