local function partOf(m)
  return m:FindFirstChild("Head") or m:FindFirstChild("UpperTorso") or m:FindFirstChild("HumanoidRootPart")
    or m:FindFirstChild("Torso") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
end

local function isAlive(info)
  return not info.dead and info.model.Parent and info.hum.Parent and info.hum.Health > 0
end

local function pickTarget()
  local _, root = getChar()
  if not root then return nil end
  local pend = pendingList()
  local prio = {}
  for i, c in ipairs(pend) do prio[c] = i end
  local best, bs
  for m, info in pairs(Z) do
    if not isAlive(info) then
      if not m.Parent then Z[m] = nil end
    else
      local p = prio[info.cat]
      local part = partOf(m)
      if p and part and (BL[m] or 0) < os.clock() then
        local d = (part.Position - root.Position).Magnitude
        local s = p * 1000000 + d
        if not bs or s < bs then best, bs = info, s end
      end
    end
  end
  return best
end

local function aliveCount(cat)
  local n = 0
  for _, info in pairs(Z) do
    if info.cat == cat and isAlive(info) then n = n + 1 end
  end
  return n
end

-- arma
local function findTool()
  local list = {}
  for _, c in ipairs({LP.Character, LP:FindFirstChildOfClass("Backpack")}) do
    if c then
      for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") then list[#list + 1] = t end
      end
    end
  end
  local key, best = norm(CFG.arma), nil
  for _, t in ipairs(list) do
    local n = norm(t.Name)
    if n == key then return t, list end
    if not best and key ~= "" and n:find(key, 1, true) then best = t end
  end
  return best, list
end

local function ammoHud(tool)
  if HUD.ammoLbl and HUD.ammoLbl.Parent then
    local c = HUD.ammoLbl.Text:match("^%s*(%d+)%s*/%s*%d+%s*$")
    if c then return tonumber(c) end
  end
  HUD.ammoLbl = nil
  if os.clock() - HUD.ammoTry < 10 then return nil end
  HUD.ammoTry = os.clock()
  local pg = LP:FindFirstChildOfClass("PlayerGui")
  if not pg then return nil end
  local tn = norm(tool.Name)
  for _, d in ipairs(pg:GetDescendants()) do
    if d:IsA("TextLabel") and norm(d.Text) == tn and not ownUi(d) then
      local anc = d.Parent
      for _ = 1, 3 do
        if anc then
          for _, e in ipairs(anc:GetDescendants()) do
            if e:IsA("TextLabel") and e.Text:match("^%s*%d+%s*/%s*%d+%s*$") then
              HUD.ammoLbl = e
              return tonumber(e.Text:match("%d+"))
            end
          end
          anc = anc.Parent
        end
      end
    end
  end
end

local function isAmmoName(n)
  n = norm(n)
  if n:find("max", 1, true) or n:find("reserve", 1, true) or n:find("total", 1, true) then return false end
  return n:find("ammo", 1, true) or n:find("municao", 1, true) or n:find("clip", 1, true)
    or n:find("mag", 1, true) or n:find("bullet", 1, true)
end

local function getAmmo(tool)
  for k, v in pairs(tool:GetAttributes()) do
    if type(v) == "number" and isAmmoName(k) then return v end
  end
  for _, d in ipairs(tool:GetDescendants()) do
    if (d:IsA("IntValue") or d:IsA("NumberValue")) and isAmmoName(d.Name) then return d.Value end
  end
  return ammoHud(tool)
end

