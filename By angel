local function isShown(o)
  local cur = o
  while cur and cur ~= game do
    if cur:IsA("GuiObject") and not cur.Visible then return false end
    if cur:IsA("ScreenGui") and not cur.Enabled then return false end
    cur = cur.Parent
  end
  return o.AbsoluteSize.X > 0 and o.AbsoluteSize.Y > 0
end

local fireObj, fireTry = nil, 0
local function findFire()
  if fireObj and fireObj.Parent and isShown(fireObj) then return fireObj end
  fireObj = nil
  if os.clock() - fireTry < 1.5 then return nil end
  fireTry = os.clock()
  local pg = LP:FindFirstChildOfClass("PlayerGui")
  if not pg then return nil end
  for _, d in ipairs(pg:GetDescendants()) do
    if d:IsA("GuiObject") then
      local hit = false
      if (d:IsA("TextButton") or d:IsA("TextLabel")) and norm(d.Text) == "fire" then hit = true
      elseif d:IsA("GuiButton") and norm(d.Name) == "fire" then hit = true end
      if hit and isShown(d) and not ownUi(d) then
        fireObj = d:IsA("GuiButton") and d or (d:FindFirstAncestorWhichIsA("GuiButton") or d)
        return fireObj
      end
    end
  end
  return nil
end

local hold = {on = false, pos = nil, t0 = 0, ammo0 = nil, altInset = false, lastMove = 0, cool = 0}
local TOUCH_ID = 9
local lastFire = 0

local function fireXY(obj)
  local c = obj.AbsolutePosition + obj.AbsoluteSize / 2
  local sg = obj:FindFirstAncestorWhichIsA("ScreenGui")
  local inset = GuiService:GetGuiInset().Y
  local ins = (sg and sg.IgnoreGuiInset) and 0 or inset
  if hold.altInset then ins = (ins == 0) and inset or 0 end
  return c.X, c.Y + ins
end

local function releaseFire()
  if not hold.on then return end
  hold.on = false
  if hold.pos and VIM then
    local x, y = hold.pos.X, hold.pos.Y
    pcall(function() VIM:SendTouchEvent(TOUCH_ID, 2, x, y) end)
    pcall(function() VIM:SendMouseButtonEvent(x, y, 0, false, game, 0) end)
  end
  if hold.sig and firesignal then pcall(firesignal, hold.sig.MouseButton1Up) end
  hold.sig = nil
end

local function pressFireHold(obj)
  local x, y = fireXY(obj)
  hold.on = true; hold.pos = Vector2.new(x, y); hold.t0 = os.clock()
  hold.ammo0 = S.ammo; hold.lastMove = os.clock()
  if VIM then
    pcall(function() VIM:SendTouchEvent(TOUCH_ID, 0, x, y) end)
    pcall(function() VIM:SendMouseButtonEvent(x, y, 0, true, game, 0) end)
  elseif firesignal and obj:IsA("GuiButton") then
    hold.sig = obj
    pcall(firesignal, obj.MouseButton1Down)
  end
end

bind(RunService.Heartbeat:Connect(function()
  local c, _, hum = getChar()
  local tool = c and findTool()
  S.weapon = tool and tool.Name or nil
  if os.clock() - (S.ammoT or 0) > 0.15 then
    S.ammoT = os.clock()
    S.ammo = tool and getAmmo(tool) or nil
  end
  local active = S.run > 0 and S.state == "EXECUTANDO" and S.aimPart and S.aimPart.Parent
  if not active or not tool then
    releaseFire()
    if active and not tool then S.fireNote = "arma não encontrada" end
    return
  end
  if tool.Parent ~= c then
    releaseFire()
    if os.clock() - lastFire > 0.3 then
      lastFire = os.clock()
      pcall(function() hum:EquipTool(tool) end)
    end
    S.fireNote = "equipando"
    return
  end
  if S.ammo and S.ammo <= 0 then
    releaseFire()
    S.fireNote = "recarregando"
    if os.clock() - (S.lastReload or 0) > 2.5 then
      S.lastReload = os.clock()
      pcall(function()
        ReplicatedStorage.WeaponAssets.Events.Reload:FireServer(tool)
      end)
    end
    return
  end
  local obj = findFire()
  if not obj then
    releaseFire()
    S.fireNote = "FIRE não achado"
    if os.clock() - lastFire >= CFG.fireRate then
      lastFire = os.clock()
      pcall(function() tool:Activate() end)
    end
    return
  end
  if hold.on then
    local x, y = fireXY(obj)
    if (Vector2.new(x, y) - hold.pos).Magnitude > 8 then releaseFire() return end
    if os.clock() - hold.lastMove > 0.2 then
      hold.lastMove = os.clock()
      if VIM then
        pcall(function() VIM:SendTouchEvent(TOUCH_ID, 1, x, y) end)
        pcall(function() VIM:SendMouseMoveEvent(x, y, game) end)
      end
    end
    if S.ammo and hold.ammo0 then
      if S.ammo < hold.ammo0 then hold.ammo0 = S.ammo; hold.t0 = os.clock() end
      if os.clock() - hold.t0 > 2 then
        releaseFire()
        hold.altInset = not hold.altInset
        hold.cool = os.clock() + 0.15
        return
      end
    end
    S.fireNote = "FIRE segurando"
  else
    if os.clock() < hold.cool then return end
    pressFireHold(obj)
    S.fireNote = "FIRE segurando"
  end
end))

-- loop principal
local function engage(info, id)
  local lastTp = 0
  local lastHp, lastHpT = info.hum.Health, os.clock()
  S.target = info
  S.aimPart = partOf(info.model)
  while S.run == id do
    if S.paused then
      setState("PAUSADO")
      releaseRoot()
      lastHpT = os.clock()
      task.wait(0.25)
    else
      setState("EXECUTANDO")
      local _, root = getChar()
      if not root then return "char" end
      if info.dead or info.hum.Health <= 0 then return "kill" end
      if not info.model.Parent then return "gone" end
      local part = partOf(info.model)
      if not part then return "gone" end
      S.aimPart = part
      S.dist = (part.Position - root.Position).Magnitude
      if os.clock() - lastTp > 1.2 then
        local hp = hoverCF and hoverCF.Position
        local far = (not hp) or Vector2.new(hp.X - part.Position.X, hp.Z - part.Position.Z).Magnitude > 25
        if far then
          teleportNear(root, info.model, part)
          lastTp = os.clock()
        end
      end
      if info.hum.Health < lastHp - 0.01 then lastHp = info.hum.Health; lastHpT = os.clock() end
      if os.clock() - lastHpT > CFG.watchdog then return "stuck" end
      task.wait(CFG.intervalo)
    end
  end
  return "stop"
end

local function stopAuto(newState)
  S.run = S.run + 1
  S.paused = false
  releaseRoot()
  S.aimPart = nil; S.target = nil; S.dist = nil
  setState(newState or "AGUARDANDO")
end

local function mainLoop(id)
  setState("EXECUTANDO")
  local lastIdleScan = 0
  while S.run == id do
    if S.paused then
      setState("PAUSADO")
      releaseRoot()
      task.wait(0.25)
    else
      local _, root = getChar()
      if not root then
        S.note = "aguardando personagem"
        task.wait(1)
      else
        scanMission(false)
        local pend, known = pendingList()
        if known and #pend == 0 then
          S.note = "missão concluída"
          stopAuto("AGUARDANDO")
          return
        end
        local info = pickTarget()
        if not info then
          S.note = "sem alvos elegíveis"
          releaseRoot()
          S.aimPart = nil; S.target = nil; S.dist = nil
          if os.clock() - lastIdleScan > 3 then refreshZombies(); lastIdleScan = os.clock() end
          task.wait(0.5)
        else
          S.note = "atacando " .. LABEL[info.cat]
          local before = HUD.prog[info.cat] and HUD.prog[info.cat].cur
          local res = engage(info, id)
          if res == "kill" then
            S.kills[info.cat] = (S.kills[info.cat] or 0) + 1
            -- espera o hud confirmar a morte antes de pegar outro alvo
            local t0 = os.clock()
            repeat
              task.wait(0.2)
              scanMission(false)
              local after = HUD.prog[info.cat] and HUD.prog[info.cat].cur
              local confirmed = (not before) or (after and after > before)
            until confirmed or os.clock() - t0 > 1.5 or S.run ~= id
          elseif res == "stuck" then
            BL[info.model] = os.clock() + 30
          end
          S.target = nil; S.aimPart = nil
        end
      end
    end
  end
end

local function startAuto()
  S.run = S.run + 1
  S.paused = false
  local id = S.run
  task.spawn(function()
    local ok, e = pcall(mainLoop, id)
    if not ok and S.run == id then
      S.run = S.run + 1
      setState("ERRO")
      releaseRoot()
      S.note = "erro: " .. tostring(e)
    end
  end)
end

-- scan automático dos alvos e da missão (a cada 10s)
task.spawn(function()
  pcall(function() refreshZombies(); scanMission(true) end)
  local t = os.clock()
  while uiAlive do
    if os.clock() - t >= 10 then
      t = os.clock()
      pcall(function() refreshZombies(); scanMission(true) end)
    else
      pcall(scanMission, false)
    end
    task.wait(0.5)
  end
end)

