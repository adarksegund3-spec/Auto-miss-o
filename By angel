-- util
local ACC = {["á"]="a",["à"]="a",["â"]="a",["ã"]="a",["ä"]="a",["é"]="e",["ê"]="e",["è"]="e",["í"]="i",["ì"]="i",
  ["ó"]="o",["ô"]="o",["õ"]="o",["ò"]="o",["ú"]="u",["ù"]="u",["ü"]="u",["ç"]="c",
  ["Á"]="a",["À"]="a",["Â"]="a",["Ã"]="a",["É"]="e",["Ê"]="e",["Í"]="i",["Ó"]="o",["Ô"]="o",["Õ"]="o",["Ú"]="u",["Ç"]="c"}
local function norm(s)
  s = tostring(s or ""):gsub("<[^>]+>", "")
  for k, v in pairs(ACC) do s = s:gsub(k, v) end
  s = s:lower():gsub("[_%-]", " "):gsub("%s+", " ")
  return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function ownUi(d)
  local sg = d:FindFirstAncestorWhichIsA("ScreenGui")
  return sg ~= nil and sg.Name:find("Rayfield", 1, true) ~= nil
end

