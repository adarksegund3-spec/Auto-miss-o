local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude
local function releaseRoot()
  local had = hoverCF
  hoverCF = nil
  if had then
    local _, root, hum = getChar()
    if hum then hum.PlatformStand = false end
    if root then
      rp.FilterDescendantsInstances = {LP.Character}
      local r = workspace:Raycast(root.Position, Vector3.new(0, -500, 0), rp)
      if r then pcall(function() root.CFrame = CFrame.new(r.Position + Vector3.new(0, 3.5, 0)) end) end
    end
  end
end

local function teleportNear(root, model, part)
  local cam = workspace.CurrentCamera
  local look = cam and cam.CFrame.LookVector or root.CFrame.LookVector
  look = Vector3.new(look.X, 0, look.Z)
  if look.Magnitude < 0.01 then look = Vector3.new(0, 0, -1) end
  look = look.Unit
  local mr = model:FindFirstChild("HumanoidRootPart")
  local baseY = mr and mr.Position.Y or part.Position.Y
  local b = part.Position
  local pos = Vector3.new(b.X - look.X * CFG.tpDist, baseY + CFG.flyAlt, b.Z - look.Z * CFG.tpDist)
  local cf = CFG.deitado and CFrame.lookAt(pos, pos + Vector3.new(0, -1, 0), look) or CFrame.lookAt(pos, pos + look)
  local ok = pcall(function()
    root.CFrame = cf
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
  end)
  if not ok then return false end
  local _, _, hm = getChar()
  if hm then hm.PlatformStand = CFG.deitado and true or false end
  hoverCF = cf
  return true
end

