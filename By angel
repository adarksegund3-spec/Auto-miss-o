local function refreshPanel()
  setLbl("note", S.note ~= "" and S.note or "pronto")
  setLbl("mission", "Missão • " .. (HUD.mission or "não detectada"))

  local tc, tm = 0, 0
  for _, c in ipairs(ORDER) do
    local g = HUD.prog[c]
    if g then
      tc = tc + g.cur; tm = tm + g.max
      local rem = math.max(0, g.max - g.cur)
      setLbl("cat_" .. c, string.format("%s  %d/%d  •  %s", LABEL[c], g.cur, g.max,
        rem > 0 and ("faltam " .. rem .. ", vivos " .. aliveCount(c)) or "concluído"))
    else
      setLbl("cat_" .. c, LABEL[c] .. "  —")
    end
  end
  local tr = tm > 0 and tc / tm or 0
  setLbl("total", "Progresso total • " .. math.floor(tr * 100 + 0.5) .. "%")

  local t = S.target
  if t and t.model and t.hum and t.hum.Parent then
    setLbl("target", string.format("Alvo • %s  HP %d/%d  %s", NOME1[t.cat] or "Zumbi",
      math.floor(math.max(t.hum.Health, 0)), math.floor(math.max(t.hum.MaxHealth, 1)),
      S.dist and (math.floor(S.dist) .. "m") or ""))
  else
    setLbl("target", "Alvo • nenhum")
  end

  setLbl("weapon", "Arma • " .. (S.weapon or "sem arma") .. (S.ammo and ("  " .. S.ammo) or "")
    .. (S.fireNote ~= "" and ("  •  " .. S.fireNote) or ""))
end

task.spawn(function()
  while uiAlive do
    pcall(refreshPanel)
    task.wait(0.4)
  end
end)

