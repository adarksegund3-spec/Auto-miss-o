-- missão (lê o hud do jogo)
local HUD = {labels = {}, prog = {}, mission = nil, ammoLbl = nil, ammoTry = 0}

local function scanMission(full)
  local pg = LP:FindFirstChildOfClass("PlayerGui")
  if not pg then return end
  if full or #HUD.labels == 0 then
    HUD.labels = {}
    for _, d in ipairs(pg:GetDescendants()) do
      if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then
        local t = d.Text
        if (t:find("/", 1, true) or norm(t):find("missao:", 1, true)) and not ownUi(d) then
          HUD.labels[#HUD.labels + 1] = d
        end
      end
    end
  end
  local newProg, mission = {}, nil
  for i = #HUD.labels, 1, -1 do
    local d = HUD.labels[i]
    if not d.Parent then
      table.remove(HUD.labels, i)
    else
      for line in d.Text:gmatch("[^\r\n]+") do
        local n = norm(line)
        local m = n:match("^missao:%s*(.+)")
        if m then mission = m:upper() end
        local name, c, mx = n:match("^(.-):%s*(%d+)%s*/%s*(%d+)")
        if name then
          local cat = classify(name)
          if cat then newProg[cat] = {cur = tonumber(c), max = tonumber(mx)} end
        end
      end
    end
  end
  if next(newProg) ~= nil or full then HUD.prog = newProg end
  if mission then HUD.mission = mission end
end

local function pendingList()
  local p, known = {}, false
  for _, c in ipairs(ORDER) do
    local g = HUD.prog[c]
    if g then
      known = true
      if g.cur < g.max then p[#p + 1] = c end
    end
  end
  if not known then return ORDER, false end
  return p, true
end

-- zumbis
local Z, BL = {}, {}

local function considerHum(h)
  local m = h.Parent
  if not m or not m:IsA("Model") or Z[m] or m == LP.Character then return end
  if Players:GetPlayerFromCharacter(m) then return end
  local txt = m.Name .. " " .. h.DisplayName .. " " .. (m.Parent and m.Parent.Name or "")
  local cat = classify(txt)
  if not cat then return end
  local info = {model = m, hum = h, cat = cat}
  info.conn = h.Died:Connect(function() info.dead = true end)
  Z[m] = info
end

local function refreshZombies()
  for m, info in pairs(Z) do
    if not m.Parent or not info.hum.Parent then
      pcall(function() info.conn:Disconnect() end)
      Z[m] = nil
    end
  end
  for _, d in ipairs(workspace:GetDescendants()) do
    if d:IsA("Humanoid") then considerHum(d) end
  end
end

