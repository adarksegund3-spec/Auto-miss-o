local function label(parent, text, size, color, font, align)
  local l = Instance.new("TextLabel", parent)
  l.BackgroundTransparency = 1; l.Text = text; l.TextSize = size or 12
  l.TextColor3 = color or C_TEXT; l.Font = font or FONT
  l.TextXAlignment = align or Enum.TextXAlignment.Left
  l.TextTruncate = Enum.TextTruncate.AtEnd
  return l
end
local function round(o, r)
  local c = Instance.new("UICorner", o); c.CornerRadius = UDim.new(0, r); return c
end
local function bar(parent, color, h)
  local bg = Instance.new("Frame", parent)
  bg.BackgroundColor3 = C_BTN; bg.BorderSizePixel = 0; bg.Size = UDim2.new(1, 0, 0, h)
  round(bg, 2)
  local f = Instance.new("Frame", bg)
  f.BackgroundColor3 = color; f.BorderSizePixel = 0; f.Size = UDim2.new(0, 0, 1, 0)
  round(f, 2)
  return bg, f
end
local function tween(o, props, t)
  TweenService:Create(o, TweenInfo.new(t or 0.3, Enum.EasingStyle.Quad), props):Play()
end

-- borda com brilho que passa (shimmer)
local function shimmer(stroke, speed, peak)
  stroke.Color = Color3.new(1, 1, 1)
  local g = Instance.new("UIGradient", stroke)
  g.Rotation = 25
  g.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, C_LINE),
    ColorSequenceKeypoint.new(0.42, C_LINE),
    ColorSequenceKeypoint.new(0.5, peak or Color3.fromRGB(215, 215, 225)),
    ColorSequenceKeypoint.new(0.58, C_LINE),
    ColorSequenceKeypoint.new(1, C_LINE),
  })
  g.Offset = Vector2.new(-1, 0)
  local tw = TweenService:Create(g, TweenInfo.new(speed or 2.4, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1),
    {Offset = Vector2.new(1, 0)})
  tw:Play()
  tweens[#tweens + 1] = tw
  return g
end

