local function titleCase(s)
  s = tostring(s or ""):lower()
  return (s:gsub("^%l", string.upper))
end

local function refreshPanel()
  -- status
  local s = STATE_TXT[S.state] or S.state
  statusTxt.Text = (S.note ~= "" and S.state ~= "AGUARDANDO") and (s .. " · " .. S.note) or s
  refreshBtn()

  -- missão
  missionName.Text = HUD.mission and titleCase(HUD.mission) or "missão não detectada"
  local tc, tm, any = 0, 0, false
  for _, c in ipairs(ORDER) do
    local row, g = rows[c], HUD.prog[c]
    if g then
      any = true
      row.frame.Visible = true
      tc = tc + g.cur; tm = tm + g.max
      row.cnt.Text = g.cur .. "/" .. g.max
      local done = g.cur >= g.max
      row.cnt.TextColor3 = done and C_OK or C_TEXT
      row.name.TextColor3 = done and C_DIM or C_TEXT
      local ratio = g.max > 0 and math.clamp(g.cur / g.max, 0, 1) or 0
      if row.ratio ~= ratio then
        row.ratio = ratio
        tween(row.fill, {Size = UDim2.new(ratio, 0, 1, 0)}, 0.3)
      end
    else
      row.frame.Visible = false
    end
  end
  emptyLbl.Visible = not any
  local tr = tm > 0 and tc / tm or 0
  pctTxt.Text = math.floor(tr * 100 + 0.5) .. "%"
  pctTxt.TextColor3 = (S.state == "EXECUTANDO") and C_OK or C_DIM

  -- alvo
  local t = S.target
  if t and t.hum and t.hum.Parent then
    local mh = math.max(t.hum.MaxHealth, 1)
    local hp = math.max(t.hum.Health, 0)
    local ratio = math.clamp(hp / mh, 0, 1)
    tgtTxt.Text = string.format("%s · %d/%d · %s", NOME1[t.cat] or "Zumbi",
      math.floor(hp), math.floor(mh), S.dist and (math.floor(S.dist) .. "m") or "—")
    hpFill.Size = UDim2.new(ratio, 0, 1, 0)
    hpFill.BackgroundColor3 = ratio > 0.5 and C_OK or (ratio > 0.25 and C_WARN or C_BAD)
  else
    tgtTxt.Text = "Sem alvo"
    hpFill.Size = UDim2.new(0, 0, 1, 0)
  end

  -- arma
  wpnTxt.Text = (S.weapon or "sem arma") .. (S.ammo and (" · " .. S.ammo) or "")
    .. (S.fireNote ~= "" and S.weapon and (" · " .. S.fireNote) or "")
end
task.spawn(function()
  while uiAlive do
    pcall(refreshPanel)
    task.wait(0.25)
  end
end)

