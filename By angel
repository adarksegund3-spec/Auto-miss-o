local ORDER = {"rei", "delta", "mutante", "rapido", "comum"}
local LABEL = {rei = "Delta Rei", delta = "Deltas", mutante = "Mutantes", rapido = "Rápidos", comum = "Zumbis"}
local KEYS = {
  rei = {"delta rei", "deltarei", "king"},
  delta = {"delta"},
  mutante = {"mutante", "mutant"},
  rapido = {"rapido", "fast", "runner"},
  comum = {"zumbi", "zombie", "zombi"},
}
local NOME1 = {rei = "Delta Rei", delta = "Delta", mutante = "Mutante", rapido = "Rápido", comum = "Zumbi"}
local function classify(text)
  text = norm(text)
  for _, cat in ipairs(ORDER) do
    for _, k in ipairs(KEYS[cat]) do
      if k ~= "" and text:find(k, 1, true) then return cat end
    end
  end
end

